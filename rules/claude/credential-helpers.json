[
  {
    "id": "claude.credential.api-key-helper",
    "name": "apiKeyHelper runs a command to supply the API key",
    "description": "apiKeyHelper is a shell command executed to produce the Anthropic API key.",
    "category": ["code-execution"],
    "appliesTo": ["claude-code"],
    "target": "credentialHelper",
    "match": {
      "condition": "and",
      "rules": [
        {"field": "variant", "op": "equals", "value": "apiKeyHelper"},
        {"field": "command", "op": "exists"}
      ]
    },
    "message": "apiKeyHelper executes a command to supply the API key",
    "references": ["https://code.claude.com/docs/en/settings"],
    "examples": [
      {"variant": "apiKeyHelper", "command": "get-key.sh"}
    ],
    "negative_examples": [
      {"variant": "awsAuthRefresh", "command": "refresh.sh"},
      {"variant": "apiKeyHelper", "command": ""}
    ]
  },
  {
    "id": "claude.credential.aws-auth-refresh",
    "name": "awsAuthRefresh runs a command to refresh AWS auth",
    "description": "awsAuthRefresh is a shell command executed to refresh AWS credentials used for Bedrock access.",
    "category": ["code-execution"],
    "appliesTo": ["claude-code"],
    "target": "credentialHelper",
    "match": {
      "condition": "and",
      "rules": [
        {"field": "variant", "op": "equals", "value": "awsAuthRefresh"},
        {"field": "command", "op": "exists"}
      ]
    },
    "message": "awsAuthRefresh executes a command to refresh AWS credentials",
    "references": ["https://code.claude.com/docs/en/settings"],
    "examples": [
      {"variant": "awsAuthRefresh", "command": "refresh.sh"}
    ],
    "negative_examples": [
      {"variant": "apiKeyHelper", "command": "get-key.sh"},
      {"variant": "awsAuthRefresh", "command": ""}
    ]
  },
  {
    "id": "claude.credential.aws-credential-export",
    "name": "awsCredentialExport runs a command to export AWS credentials",
    "description": "awsCredentialExport is a shell command executed to export AWS credentials into the environment.",
    "category": ["code-execution"],
    "appliesTo": ["claude-code"],
    "target": "credentialHelper",
    "match": {
      "condition": "and",
      "rules": [
        {"field": "variant", "op": "equals", "value": "awsCredentialExport"},
        {"field": "command", "op": "exists"}
      ]
    },
    "message": "awsCredentialExport executes a command to export AWS credentials",
    "references": ["https://code.claude.com/docs/en/settings"],
    "examples": [
      {"variant": "awsCredentialExport", "command": "export.sh"}
    ],
    "negative_examples": [
      {"variant": "awsAuthRefresh", "command": "refresh.sh"},
      {"variant": "awsCredentialExport", "command": ""}
    ]
  }
]
